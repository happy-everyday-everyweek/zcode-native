+  const hextets: string[] = [];
+  for (const h of head) hextets.push(h);
+  for (let i = 0; i < missing; i += 1) hextets.push("0");
+  for (const h of tail) hextets.push(h);
+  if (hextets.length !== 8) return undefined;
