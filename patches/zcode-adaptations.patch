+function portIpv4ToInt(address: string): number | undefined {
+  const parts = address.split(".");
+  if (parts.length !== 4) return undefined;
+  let value = 0;
+  for (const part of parts) {
+    const n = Number(part);
+    if (!Number.isInteger(n) || n < 0 || n > 255) return undefined;
+    value = value * 256 + n;
+  }
+  return value;
+}
+function portExpandIpv6(value: string): number[] | undefined {
+  const parts = value.toLowerCase().split("::");
+  if (parts.length > 2) return undefined;
+  const head = parts[0] ? parts[0]!.split(":") : [];
+  const tail = parts.length === 2 && parts[1] !== undefined && parts[1] !== "" ? parts[1]!.split(":") : [];
+  const missing = 8 - head.length - tail.length;
+  if (missing < 0) return undefined;
+  const hextets: string[] = [];
+  for (const h of head) hextets.push(h);
+  for (let i = 0; i < missing; i += 1) hextets.push("0");
+  for (const h of tail) hextets.push(h);
+  if (hextets.length !== 8) return undefined;
+  const out: number[] = [];
+  for (const h of hextets) {
+    const n = parseInt(h === "" ? "0" : h, 16);
+    if (Number.isNaN(n) || n < 0 || n > 0xffff) return undefined;
+    out.push(n);
+  }
+  return out;
+}
+function portIsIP(value: string): 0 | 4 | 6 {
+  if (portIpv4ToInt(value) !== undefined) return 4;
+  if (portExpandIpv6(value) !== undefined) return 6;
+  return 0;
+}
+class PortBlockList {
+  private readonly entries: { address: string; prefix: number; family: "ipv4" | "ipv6" }[] = [];
+  addSubnet(address: string, prefix: number, family: "ipv4" | "ipv6"): void {
+    this.entries.push({ address, prefix, family });
+  }
+  check(address: string, family: "ipv4" | "ipv6"): boolean {
+    for (const entry of this.entries) {
+      if (entry.family !== family) continue;
+      if (family === "ipv4") {
+        const a = portIpv4ToInt(address);
+        const b = portIpv4ToInt(entry.address);
+        if (a === undefined || b === undefined) continue;
+        const mask = entry.prefix >= 32 ? 0xffffffff : ((0xffffffff << (32 - entry.prefix)) >>> 0);
+        if (((a & mask) >>> 0) === ((b & mask) >>> 0)) return true;
+      } else {
+        const a = portExpandIpv6(address);
+        const b = portExpandIpv6(entry.address);
+        if (a === undefined || b === undefined) continue;
+        let bits = 0;
+        let matched = true;
+        for (let i = 0; i < 8 && bits < entry.prefix; i += 1) {
+          const take = Math.min(16, entry.prefix - bits);
+          const mask = take >= 16 ? 0xffff : ((0xffff << (16 - take)) & 0xffff);
+          if ((a[i]! & mask) !== (b[i]! & mask)) { matched = false; break; }
