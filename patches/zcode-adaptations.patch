+/** 记录键枚举。scriptc 只对**泛型记录**参数上的 Object.keys 有 lowering，
+ *  `Record<string, any>` 的写法没有（SC2020），所以调用方先把值类型擦成 unknown 再传进来。 */
+function recordKeys<T>(rec: Record<string, T>): string[] {
+  return Object.keys(rec);
+}
+
+export function sparseShape(shape: Record<string, any>): ZodRawShape {
+  const sparse: ZodRawShape = {};
+  // scriptc：`Record<string, any>` 上的 Object.keys 无 lowering（SC2020），
+  // 而泛型记录上的还有（同文件外的 omitKey 就是这么过的）；这里绑定一份
+  // unknown 值类型的记录只用于枚举键，取值仍从原记录拿，保持 any 语义。
+  const keysOf: Record<string, unknown> = shape;
+  for (const key of recordKeys(keysOf)) {
+    const schema = shape[key];
+    sparse[key] = schema.nullable().optional();
+  }
+  return sparse;
+}
+
+/**
+ * 原样复制 zod shape，供 `...schema.shape` 形态的对象展开使用。
+ *
+ * scriptc 不认 `Object.fromEntries`，也不肯展开类型为 `any` 的 `.shape`（compat 的 shape
+ * getter 是 any）；复制成索引签名记录后两个问题都没有了。
+ */
+export function copyShape(shape: Record<string, any>): ZodRawShape {
+  const copied: ZodRawShape = {};
+  // 同 sparseShape：键枚举走 recordKeys（泛型记录上的 Object.keys 才有 lowering）。
+  const keysOf: Record<string, unknown> = shape;
+  for (const key of recordKeys(keysOf)) {
+    copied[key] = shape[key];
+  }
+  return copied;
 }
